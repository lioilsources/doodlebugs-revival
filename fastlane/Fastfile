default_platform(:ios)

# fastlane executes the Fastfile from inside the fastlane/ directory, so a bare
# relative path here silently points at fastlane/Builds/... which never exists.
# Anchor everything to the repo root instead.
ROOT             = File.expand_path("..", __dir__)
XCODE_PROJECT    = File.join(ROOT, "Builds/iOS/Unity-iPhone.xcodeproj")
APP_TARGET       = "Unity-iPhone"
FRAMEWORK_TARGET = "UnityFramework"

# The App Store Connect API key lives in secrets in one of two shapes depending on
# how it was uploaded. Prefer the base64 variant: a raw .p8 pasted into a secret
# keeps its newlines only by luck, and when it doesn't the failure surfaces much
# later as an opaque "invalid signature" from Apple.
def asc_api_key
  key_b64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]
  key_raw = ENV["APPSTORE_API_PRIVATE_KEY"]

  content, is_base64 =
    if key_b64.to_s.strip.empty?
      UI.user_error!("Neither APP_STORE_CONNECT_API_KEY_BASE64 nor APPSTORE_API_PRIVATE_KEY is set") if key_raw.to_s.strip.empty?
      [key_raw, false]
    else
      [key_b64.strip, true]
    end

  app_store_connect_api_key(
    key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
    issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
    key_content: content,
    is_key_content_base64: is_base64,
    in_house: false
  )
end

platform :ios do
  desc "Build the Unity-generated Xcode project and ship it to TestFlight"
  lane :ios_beta do
    api_key = asc_api_key

    UI.user_error!("#{XCODE_PROJECT} not found — run ci/unity-build.sh ios first") unless File.exist?(XCODE_PROJECT)

    # Xcode 26 cannot resolve a provisioning profile by NAME even when it sits in
    # ~/Library/MobileDevice/Provisioning Profiles — PROVISIONING_PROFILE_SPECIFIER
    # has to carry the UUID. Both come from ci/install-profile.sh, which also reads
    # the team out of the profile itself so a stale IOS_TEAM_ID secret cannot break
    # signing; the secret stays as a fallback only.
    profile_uuid = ENV.fetch("PROFILE_UUID")
    team_id      = ENV["PROFILE_TEAM_ID"] || ENV.fetch("IOS_TEAM_ID")
    bundle_id    = ENV["BUNDLE_ID_IOS"] || "com.ol1n.doodlebugsRevival"

    # iOSPostProcessBuild sets CODE_SIGN_STYLE=Automatic on both targets so a plain
    # local `xcodebuild` provisions itself. That cannot work here: automatic signing
    # needs an Xcode account signed in, and the runner is a headless daemon. So both
    # targets get flipped back to manual after every Unity build — it has to happen
    # after, because Unity regenerates the project each time.
    #
    # Only the app target carries the provisioning profile. UnityFramework is an
    # embedded framework: it needs an identity but no profile of its own, and is
    # re-signed with the app's identity when embedded. Leaving it on Automatic makes
    # the archive step fail with "No signing certificate found".
    update_code_signing_settings(
      path: XCODE_PROJECT,
      targets: [APP_TARGET],
      use_automatic_signing: false,
      team_id: team_id,
      profile_name: profile_uuid,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: bundle_id
    )

    update_code_signing_settings(
      path: XCODE_PROJECT,
      targets: [FRAMEWORK_TARGET],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      project: XCODE_PROJECT,
      scheme: APP_TARGET,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "Builds/ipa"),
      output_name: "doodlebugs.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { bundle_id => profile_uuid }
      }
    )

    # skip_waiting_for_build_processing keeps the runner from idling for the 10–30
    # minutes Apple takes to process a build. Export compliance is already declared
    # in Info.plist by iOSPostProcessBuild, so nothing downstream needs a human.
    #
    # No changelog here: fastlane rejects it together with
    # skip_waiting_for_build_processing, because the "What to Test" text can only be
    # attached once Apple has finished processing. The version and build number
    # already identify the build in TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Upload the signed APK to Firebase App Distribution"
  lane :android_beta do
    # APK_PATH arrives relative to the repo root; expand it against ROOT because
    # fastlane's working directory is fastlane/, not the repo (see header).
    apk_path = File.expand_path(ENV["APK_PATH"] || "Builds/Android/doodlebugs-signed.apk", ROOT)
    UI.user_error!("#{apk_path} not found — run ci/unity-build.sh android first") unless File.exist?(apk_path)

    # service_credentials_file, not firebase_cli_token: the token flow is deprecated
    # and Google has been switching it off for new projects.
    common = {
      app: ENV.fetch("FIREBASE_ANDROID_APP_ID"),
      service_credentials_file: ENV.fetch("FIREBASE_SA_PATH"),
      apk_path: apk_path,
      release_notes: ENV["RELEASE_NOTES"]
    }

    begin
      firebase_app_distribution(common.merge(groups: ENV["FIREBASE_GROUPS"] || "testers"))
    rescue => e
      # The upload and the hand-out to testers are two separate API calls, and
      # only the second one is failing here ("HALTED release must have
      # fraction"). Failing the whole job at that point throws away a build
      # that is already sitting in the Firebase console, so retry without the
      # group and let a human hand it out.
      UI.important("Distributing to the tester group failed: #{e.message}")
      UI.important("Retrying upload without a group — the release will need to " \
                   "be handed out from the Firebase console.")
      firebase_app_distribution(common)
      UI.important("Uploaded, but NOT distributed to testers. Check the group " \
                   "alias in FIREBASE_GROUPS against the Firebase console.")
    end
  end
end
